# Clerk's development instance (pk_test_, sk_test_). The stack refuses production keys.
E2E_CLERK_PUBLISHABLE_KEY=
E2E_CLERK_SECRET_KEY=
# A local Postgres; the stack creates the database. Defaults to the test Postgres on 5499.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5499/insidejoke_e2e
# Optional: runs the agent tests. Without it they are skipped.
ANTHROPIC_API_KEY=
