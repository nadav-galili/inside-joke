    "@hono/node-server": "^1.19.0",
    "@insidejoke/db": "workspace:*",
    "@insidejoke/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
