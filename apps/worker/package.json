{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "make-video": "tsx --env-file-if-exists=.env src/make-video.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fal-ai/client": "^1.10.1",
    "@insidejoke/db": "workspace:*",
    "@insidejoke/shared": "workspace:*",
    "@sentry/node": "^11.8.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
